{
  "info": {
    "name": "Biblioteca ITT - API",
    "description": "Practica 3: consumo de una API Spring Boot desde Flutter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1. Bienvenida (prueba de conexion)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/",
          "host": [
            "{{base}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "2. Listar libros",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api/libros",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "libros"
          ]
        }
      }
    },
    {
      "name": "3. Obtener un libro",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base}}/api/libros/1",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "libros",
            "1"
          ]
        }
      }
    },
    {
      "name": "4. Crear un libro (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/libros",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "libros"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Rayuela\",\n  \"autor\": \"Julio Cortázar\",\n  \"anio\": 1963,\n  \"disponible\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Actualizar un libro (200)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base}}/api/libros/1",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "libros",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Cien años de soledad\",\n  \"autor\": \"Gabriel García Márquez\",\n  \"anio\": 1967,\n  \"disponible\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. Eliminar un libro (204)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base}}/api/libros/2",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "libros",
            "2"
          ]
        }
      }
    }
  ]
}